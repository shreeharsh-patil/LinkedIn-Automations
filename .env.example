# ==============================================================================
# LinkedCtl + Flow Agent Automation Platform Configuration
# ==============================================================================
# Copy this file to .env and configure your credentials.
# NEVER COMMIT YOUR .env FILE OR EXPOSE SECRETS IN VERSION CONTROL.
# ==============================================================================

# --- Safe Review / Dry Run Mode -----------------------------------------------
# In dry-run mode, the entire pipeline (research, generation, validation, 
# media preparation, deduplication) runs normally EXCEPT the final LinkedIn publish call.
DRY_RUN=false

# --- Automation Mode ----------------------------------------------------------
# Mode can be:
#   "safe"  - Requires manual approval in Studio before any post can be scheduled or published.
#   "semi"  - Automatically schedules posts after approval window expires.
#   "full"  - Fully autonomous pipeline (Flow Agent -> Validation -> Auto-Publish).
AUTOMATION_MODE=safe
APPROVAL_WINDOW_HOURS=24

# --- LinkedCtl Studio Server --------------------------------------------------
PORT=3000
OUTPUT_FOLDER=./projects
OUTPUT_RESOLUTION=1080p
ASPECT_RATIO=landscape
PARALLEL_GENERATIONS=1
RETRY_COUNT=3

# --- Flow Agent Local Backend -------------------------------------------------
FLOW_AGENT_URL=http://127.0.0.1:8001
FLOW_AGENT_API_URL=http://127.0.0.1:8001
FLOW_GENERATION_TIMEOUT_MS=300000
FLOW_HEALTH_TIMEOUT_MS=5000

# --- LLM Provider Selection --------------------------------------------------
# Supported: gemini, groq, openrouter, openai, auto
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- LLM API Keys (At least one key is recommended for content generation) ----
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=

# --- LinkedIn OAuth & Publishing (via LinkedCtl) -----------------------------
# You can authenticate via CLI: `linkedctl auth login` (recommended)
# Or provide tokens explicitly:
LINKEDCTL_PROFILE=default
# LINKEDCTL_ACCESS_TOKEN=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
