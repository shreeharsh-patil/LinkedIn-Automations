{
  "name": "linkedctl",
  "version": "0.0.0",
  "description": "The complete CLI & MCP for LinkedIn",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only",
  "author": "shreeharsh-patil (https://github.com/shreeharsh-patil)",
  "homepage": "https://github.com/shreeharsh-patil/LinkedIn-Automations",
  "bugs": "https://github.com/shreeharsh-patil/LinkedIn-Automations/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreeharsh-patil/LinkedIn-Automations.git",
    "directory": "packages/linkedctl"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "linkedctl": "./dist/cli.js"
  },
  "mcpName": "io.github.shreeharsh-patil/LinkedIn-Automations",
  "keywords": [
    "linkedin",
    "social-media",
    "oauth2",
    "mcp",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "node -e \"fs.copyFileSync('../../README.md', './README.md'); fs.copyFileSync('../../LICENSE', './LICENSE')\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@linkedctl/cli": "workspace:^",
    "@linkedctl/mcp": "workspace:^",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
