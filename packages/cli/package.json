{
  "name": "@linkedctl/cli",
  "version": "0.0.0",
  "description": "CLI for LinkedIn API integration",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only",
  "author": "shreeharsh-patil (https://github.com/shreeharsh-patil)",
  "homepage": "https://github.com/shreeharsh-patil/LinkedIn-Automations",
  "bugs": "https://github.com/shreeharsh-patil/LinkedIn-Automations/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreeharsh-patil/LinkedIn-Automations.git",
    "directory": "packages/cli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "linkedctl-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "keywords": [
    "linkedin",
    "social-media",
    "cli",
    "command-line",
    "linkedin-api"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "node -e \"fs.copyFileSync('../../LICENSE', './LICENSE')\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@linkedctl/core": "workspace:^",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
